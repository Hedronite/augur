[]byte("# Example Augur policy. Alert names follow the real rule set; hosts are synthetic.\n# The real policy lives off-repo on the deploy host (mode 0640).\nschema: augur.policy/v0\ndefault: YELLOW                 # severity for an alert no rule matches; GREEN is rejected\nhost_label: host                # label that carries the host slug (falls back to instance)\nreplica_label: replica          # label that names the Prometheus replica (two-view rules)\nreplicas: [r1, r2]              # views whose alerts reach the source; unset means one unlabeled view\n                                # set here for illustration; the deployed policy leaves it unset (single view)\nwatchdog:\n  alertname: Watchdog\n  deadman_window: 5m            # used by `serve` only\nnode_exporter_red_hold: 10m\nfirst_class_hosts: [host-a, host-b, host-c, host-d]\n\n# Every matching rule applies; the worst severity wins.\n# A matcher value is a string (label equality) or { regex: \"...\" } (anchored regex).\nrules:\n  - id: peer-prom-down\n    match: { alertname: PeerPrometheusDown }\n    severity: YELLOW\n  - id: peer-prom-absent\n    match: { alertname: PeerPrometheusAbsent }\n    severity: YELLOW\n  - id: node-exporter-down\n    match: { alertname: NodeExporterDown }\n    severity: YELLOW\n    escalate: { to: RED, after: node_exporter_red_hold, hosts: first_class }\n  - id: ssh-failure\n    match: { alertname: SSHFailure }\n    severity: YELLOW\n  - id: disk-warn\n    match: { alertname: DiskSpaceWarning, host: { regex: \"host-[ab]\" } }\n    severity: YELLOW\n  - id: disk-crit\n    match: { alertname: DiskSpaceCritical, host: { regex: \"host-[ab]\" } }\n    severity: YELLOW\n\n# Alerts that are expected. They never raise the overall verdict.\nholds:\n  - id: kube-api-dark\n    match: { port: \"6443\" }\n    kind: expected_dark\n  - id: legacy-forward-dark\n    match: { port: \"18080\" }\n    kind: known_hold\n  - id: maint-host-e\n    match: { host: host-e }\n    kind: announced_dark\n    expires_at: 2026-12-01T00:00:00Z\n")
